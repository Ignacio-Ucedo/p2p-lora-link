# NOTA (rama esp32-devkit-node): el ESP32 clásico NO tiene USB-Serial/JTAG nativo;
# la consola va por UART0 (GPIO1/GPIO3) a través del puente USB-UART del devkit,
# que es el default. Por eso NO forzamos USB_SERIAL_JTAG acá (rompería la consola).
# En el C3 (rama rust-lr1121) sí hace falta: CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE / NimBLE — requerido por esp32-nimble. El C3 tiene BLE interno (2.4 GHz),
# independiente del LR1121 (sub-GHz por SPI): no compiten.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=4096
